# Copy this file to .env for local testing (never commit the real .env).
# In production (Render), these get added under Environment in the dashboard,
# not as a file — see README.md.

# ── Supabase ──
# Dashboard → Settings → API → Project URL
SUPABASE_URL=https://oiwgadfjrkuzjkvhugos.supabase.co
# Dashboard → Settings → API → service_role key (NOT the anon/public key)
# This key bypasses Row Level Security — keep it server-side only, never in
# any frontend file, never committed to git.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend ──
# Dashboard → API Keys
RESEND_API_KEY=
# While no custom domain is verified, this MUST stay as onboarding@resend.dev
# and Resend will only actually deliver to your own account email for testing.
# Once a real domain is verified with Resend, change this to something like
# waitlist@campusbulkmart.com (or whatever domain you end up with).
RESEND_FROM_EMAIL=Campus Bulkmart <onboarding@resend.dev>

# ── CORS ──
# Comma-separated list of frontend origins allowed to call this API.
# Add your custom domain here later once you have one.
ALLOWED_ORIGINS=https://campusbulkmart.web.app,http://localhost:3000,http://127.0.0.1:5500
