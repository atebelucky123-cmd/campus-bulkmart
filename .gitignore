# ============================================================
# Campus Bulkmart — .gitignore (Phase 1 rewrite)
# Covers both the frontend (root) and server/ backend, since they
# live in the same repo per README.md's setup instructions.
# ============================================================

# Dependencies
node_modules/
server/node_modules/

# Secrets — never commit any of these
.env
.env.*
!.env.example
firebase-service-account.json
server/firebase-service-account.json
supabase/firebase-service-account.json
serviceAccountKey.json

# Build output — regenerated by build.js/copy-assets.js, no need to track it
dist/

# Firebase local cache/debug files
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# OS/editor cruft
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Editor folders (optional — remove this line if you want .vscode/ tracked)
.vscode/
